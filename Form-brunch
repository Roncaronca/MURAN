  height: "100vh",
  display: "flex",
  flexDirection: "column",
  justifyContent: "center",
  alignItems: "center",
  textAlign: "center",
  backgroundImage: "linear-gradient(rgba(0,0,0,0.5), rgba(0,0,0,0.8)), url('https://images.unsplash.com/photo-1552674605-db6ffd4facb5?q=80&w=1600&auto=format&fit=crop')",
  backgroundSize: "cover",
  backgroundPosition: "center",
};

const titleStyle = { fontSize: "clamp(60px, 15vw, 150px)", fontWeight: "900", lineHeight: "0.8", margin: "20px 0", letterSpacing: "-2px" };
const badgeStyle = { border: "2px solid #fff", padding: "5px 15px", fontWeight: "bold", letterSpacing: "3px", fontSize: "12px" };
const subtitleStyle = { fontSize: "20px", maxWidth: "600px", opacity: 0.9, marginBottom: "30px" };
const ctaStyle = { background: "#fff", color: "#000", padding: "20px 40px", fontWeight: "900", textDecoration: "none", borderRadius: "5px", fontSize: "18px" };

const gridStyle = { display: "grid", gridTemplateColumns: "repeat(auto-fit, minmax(250px, 1fr))", gap: "30px" };
const infoBoxStyle = { borderLeft: "4px solid #fff", paddingLeft: "20px" };
const iconStyle = { fontSize: "30px", display: "block", marginBottom: "10px" };

const formSectionStyle = { padding: "100px 20px", backgroundColor: "#111", display: "flex", flexDirection: "column", alignItems: "center" };
const formStyle = { width: "100%", maxWidth: "500px", display: "flex", flexDirection: "column", gap: "20px" };
const labelStyle = { fontSize: "12px", fontWeight: "bold", textTransform: "uppercase", letterSpacing: "1px", color: "#aaa" };
const inputStyle = { padding: "15px", background: "#222", border: "1px solid #333", color: "#fff", fontSize: "16px" };
const submitButtonStyle = { background: "#fff", color: "#000", border: "none", padding: "20px", fontWeight: "900", cursor: "pointer", marginTop: "20px" };
const payPalButtonStyle = { background: "#0070ba", color: "#fff", padding: "20px 50px", fontWeight: "900", textDecoration: "none", borderRadius: "50px", display: "inline-block" };
