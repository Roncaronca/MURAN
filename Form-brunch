"use client";

import { useState } from "react";

export default function MubrunchLanding() {
  const [submitted, setSubmitted] = useState(false);
  const [loading, setLoading] = useState(false);

  async function handleSubmit(e) {
    e.preventDefault();
    setLoading(true);

    const formData = new FormData(e.target);
    
    // SOSTITUISCI 'TUO_ID_FORMSPREE' con l'ID che ottieni su formspree.io
    const response = await fetch("https://formspree.io/f/TUO_ID_FORMSPREE", {
      method: "POST",
      body: formData,
      headers: { 'Accept': 'application/json' }
    });

    if (response.ok) {
      setSubmitted(true);
    } else {
      alert("Si è verificato un errore. Riprova o contattaci!");
    }
    setLoading(false);
  }

  return (
    <div style={{ backgroundColor: "#000", color: "#fff", fontFamily: 'Helvetica Neue, Arial, sans-serif', margin: 0 }}>
      
      {/* HERO SECTION */}
      <section style={heroStyle}>
        <div style={badgeStyle}>MUBRUNCH 2026</div>
        <h1 style={titleStyle}>MOVE.<br/>RUN.<br/>BRUNCH.</h1>
        <p style={subtitleStyle}>Una mattinata di energia e community a Terraviva.</p>
        <a href="#signup" style={ctaStyle}>ISCRIVITI ORA</a>
      </section>

      {/* INFO EVENTO */}
      <section style={{ padding: "80px 20px", maxWidth: "1000px", margin: "0 auto" }}>
        <div style={gridStyle}>
          <div style={infoBoxStyle}>
            <span style={iconStyle}>📍</span>
            <h3>Location</h3>
            <p>Terraviva, Via delle Erbe 29</p>
          </div>
          <div style={infoBoxStyle}>
            <span style={iconStyle}>🗓</span>
            <h3>Data e Ora</h3>
            <p>Domenica 17/05 • Ore 09:30</p>
          </div>
          <div style={infoBoxStyle}>
            <span style={iconStyle}>💰</span>
            <h3>Quote</h3>
            <p>17€ Early Bird (entro 13/05)<br/>20€ Standard</p>
          </div>
        </div>
      </section>

      {/* REGISTRATION FORM */}
      <section id="signup" style={formSectionStyle}>
        {!submitted ? (
          <>
            <h2 style={{ fontSize: "40px", fontWeight: "900", marginBottom: "40px" }}>REGISTRATION FORM</h2>
            <form onSubmit={handleSubmit} style={formStyle}>
              
              <label style={labelStyle}>Nome e Cognome</label>
              <input name="nome_cognome" required style={inputStyle} placeholder="Es. Mario Rossi" />

              <label style={labelStyle}>Email</label>
              <input name="email" type="email" required style={inputStyle} placeholder="mario@esempio.com" />

              <label style={labelStyle}>Numero di Telefono</label>
              <input name="telefono" type="tel" required style={inputStyle} placeholder="+39 333..." />

              <label style={labelStyle}>Tipo di Partecipazione</label>
              <select name="partecipazione" style={inputStyle}>
                <option>Pilates + Corsa + Brunch</option>
                <option>Solo Corsa + Brunch</option>
                <option>Solo Brunch</option>
              </select>

              <label style={labelStyle}>Distanza Corsa</label>
              <select name="distanza" style={inputStyle}>
                <option>3 km</option>
                <option>5 km</option>
                <option>8 km</option>
              </select>

              <label style={labelStyle}>Hai già un tappetino?</label>
              <select name="tappetino" style={inputStyle}>
                <option>Sì</option>
                <option>No (mi organizzo)</option>
              </select>

              <label style={labelStyle}>Allergie / Intolleranze</label>
              <textarea name="allergie" rows="3" style={inputStyle} placeholder="Segnala qui eventuali esigenze alimentari..."></textarea>

              <label style={labelStyle}>Note aggiuntive (facoltativo)</label>
              <input name="note" style={inputStyle} />

              <div style={{ display: "flex", alignItems: "start", gap: "10px", marginTop: "10px" }}>
                <input type="checkbox" required name="accettazione_regolamento" id="reg" style={{ marginTop: "5px" }} />
                <label htmlFor="reg" style={{ fontSize: "12px", opacity: 0.7 }}>
                  Confermo di partecipare e accetto le condizioni dell’evento. ⚠️ Ricorda di portare il tappetino!
                </label>
              </div>

              <button type="submit" disabled={loading} style={submitButtonStyle}>
                {loading ? "INVIO IN CORSO..." : "CONFERMA E PROCEDI AL PAGAMENTO"}
              </button>
            </form>
          </>
        ) : (
          <div style={{ textAlign: "center", padding: "60px 0" }}>
            <h2 style={{ fontSize: "60px", fontWeight: "900" }}>CHECK-IN AVVENUTO ✅</h2>
            <p style={{ fontSize: "20px", marginBottom: "40px" }}>Per completare l'iscrizione, effettua il pagamento ora:</p>
            <a href="https://www.paypal.com/IL_TUO_LINK" style={payPalButtonStyle}>PAGA CON PAYPAL</a>
            <p style={{ marginTop: "20px", opacity: 0.6, fontSize: "14px" }}>
              📌 Nota: Inserisci il tuo nome e cognome nella causale di PayPal.
            </p>
          </div>
        )}
      </section>

      <footer style={{ padding: "40px", textAlign: "center", opacity: 0.4, fontSize: "12px" }}>
        MUBRUNCH EXPERIENCE © 2026 — NEVER STOP MOVING.
      </footer>
    </div>
  );
}

// STILI (Nike Style)
